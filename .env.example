# Ledger settings. Copy to .env for local runs.

# Where Cockpit runs. Ledger accepts its launch tickets and nothing else.
COCKPIT_URL=http://localhost:5173
# Without Cockpit, a password-less developer sign-in (never in production).
DEV_SIGNIN=on

# Postgres. Without it, development keeps everything in memory and forgets on restart.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger

# Signs session tokens. Random per start when blank.
# SESSION_SECRET=

# Lets Cockpit read totals and Watson and Rook-E read grant figures.
# LEDGER_SERVICE_TOKEN=

# Links a grant's funder in Rollodex (optional).
# ROLLODEX_URL=http://localhost:8795
# ROLLODEX_SERVICE_TOKEN=

# The organization's calendar: "today" and a grant's period are counted in it.
TZ_DISPLAY=America/Los_Angeles

PORT=8797
